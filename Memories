<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Our Love Story ❤️</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #1a001f, #4b003e, #16001c);
            color: white;
            font-family: Georgia, serif;
            text-align: center;
            overflow: hidden;
        }

        .container {
            padding: 30px;
        }

        .heart {
            font-size: 80px;
            animation: heartbeat 1.5s infinite;
        }

        h1 {
            font-size: 50px;
            margin: 20px 0;
        }

        p {
            font-size: 20px;
            opacity: 0.85;
        }

        .start-button {
            margin-top: 35px;
            padding: 15px 35px;
            border: none;
            border-radius: 30px;
            background: white;
            color: #8b005d;
            font-size: 18px;
            cursor: pointer;
        }

        .start-button:hover {
            transform: scale(1.08);
        }

        @keyframes heartbeat {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.25);
            }

            100% {
                transform: scale(1);
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="heart">❤️</div>

        <h1>Our Love Story</h1>

        <p>Two people. One beautiful story.</p>

        <button class="start-button">
            Begin Our Story ✨
        </button>

    </div>

</body>
</html>
